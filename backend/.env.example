PORT=5000
NODE_ENV=development

# Monnify Configuration
MONNIFY_API_KEY=your_monnify_api_key_here
MONNIFY_SECRET_KEY=your_monnify_secret_key_here
MONNIFY_CONTRACT_CODE=your_monnify_contract_code_here
MONNIFY_BASE_URL=https://api.monnify.com

# ClubKonnect Configuration
CLUBKONNECT_API_KEY=your_clubkonnect_api_key_here
CLUBKONNECT_BASE_URL=your_clubkonnect_base_url_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gy_data_app
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Monnify Webhook Secret
MONNIFY_WEBHOOK_SECRET=your_webhook_secret_key_here
